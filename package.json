{
  "name": "election-night-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "tsc --noEmit",
    "test": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "check:json": "python3 scripts/check_generated_json.py",
    "check:official": "python3 scripts/compare_county_presidential_official_sources.py",
    "check": "python3 -m py_compile scripts/*.py && npm run lint && npm test && npm run check:json && npm run check:official",
    "data:download": "python3 scripts/fetch_results.py",
    "data:import": "python3 scripts/import_mit_county_presidential.py",
    "data:validate": "python3 scripts/validate_mit_county_presidential.py",
    "data:generate": "python3 scripts/generate_county_presidential_summary.py",
    "data:normalize": "python3 scripts/normalize_county_presidential_geographies.py",
    "data:geography-aliases": "python3 scripts/register_county_presidential_geography_aliases.py",
    "data:coverage": "python3 scripts/generate_county_presidential_coverage.py",
    "data:official:nc:download": "python3 scripts/download_north_carolina_presidential.py",
    "data:official:nc:merge": "python3 scripts/merge_north_carolina_presidential.py",
    "data:official:nc": "npm run data:official:nc:download && npm run data:official:nc:merge",
    "data:official:va:download": "python3 scripts/download_virginia_presidential.py",
    "data:official:va:merge": "python3 scripts/merge_virginia_presidential.py",
    "data:official:va": "npm run data:official:va:download && npm run data:official:va:merge",
    "data:official:ga:download": "python3 scripts/download_georgia_presidential.py",
    "data:official:ga:merge": "python3 scripts/merge_georgia_presidential.py",
    "data:official:ga": "npm run data:official:ga:download && npm run data:official:ga:merge",
    "data:official:ky:download": "python3 scripts/download_kentucky_presidential.py",
    "data:official:ky:merge": "python3 scripts/merge_kentucky_presidential.py",
    "data:official:ky": "npm run data:official:ky:download && npm run data:official:ky:merge",
    "data:official:wi:download": "python3 scripts/download_wisconsin_presidential.py",
    "data:official:wi:merge": "python3 scripts/merge_wisconsin_presidential.py",
    "data:official:wi": "npm run data:official:wi:download && npm run data:official:wi:merge",
    "data:supplement:download": "python3 scripts/download_county_presidential_supplement.py",
    "data:supplement:merge": "python3 scripts/merge_county_presidential_supplement.py",
    "data:supplement": "npm run data:supplement:download && npm run data:supplement:merge && npm run data:coverage",
    "data:fetch": "bash scripts/import_mit_pipeline.sh",
    "florida:download": "python3 scripts/download_florida_precinct.py --all",
    "florida:import": "python3 scripts/import_florida_general.py --all",
    "florida:validate": "python3 scripts/validate_florida_general.py --all",
    "florida:generate": "python3 scripts/generate_florida_summary.py --all",
    "florida:districts:generate": "python3 scripts/generate_florida_district_drilldown.py --all",
    "florida:fetch": "bash scripts/import_florida_pipeline.sh",
    "florida:download:year": "python3 scripts/download_florida_precinct.py --year",
    "florida:import:year": "python3 scripts/import_florida_general.py --year",
    "florida:validate:year": "python3 scripts/validate_florida_general.py --year",
    "florida:generate:year": "python3 scripts/generate_florida_summary.py --year",
    "florida:districts:generate:year": "python3 scripts/generate_florida_district_drilldown.py --year",
    "florida:geometry:download": "python3 scripts/download_florida_geometry.py",
    "florida:geometry:register": "python3 scripts/register_florida_geometry.py",
    "florida:geometry:geojson": "python3 scripts/generate_florida_geometry_geojson.py",
    "florida:geometry:validate": "python3 scripts/validate_florida_geometry.py",
    "florida:geometry:generate": "python3 scripts/generate_florida_geometry_manifest.py",
    "florida:geometry:fetch": "bash scripts/import_florida_geometry_pipeline.sh",
    "california:download": "python3 scripts/download_california_statewide.py",
    "california:generate": "python3 scripts/generate_california_statewide_summary.py",
    "california:fetch": "npm run california:download && npm run california:generate",
    "db:apply": "bash scripts/db_apply.sh"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "d3-array": "^3.2.4",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1",
    "vite": "^7.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.1",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-scale": "^4.0.8",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/topojson-client": "^3.1.4",
    "typescript": "^5.8.3"
  }
}
